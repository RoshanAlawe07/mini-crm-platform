{
  "info": {
    "name": "Vendor API Integration Testing",
    "description": "Complete testing of vendor API integration with 90/10 success/failure simulation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Setup - Create Test Customers",
      "item": [
        {
          "name": "Create Customer 1 - High Spender",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John High Spender\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"123-456-7890\",\n  \"totalSpend\": 15000,\n  \"visitsCount\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "customers"]
            }
          }
        },
        {
          "name": "Create Customer 2 - Medium Spender",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Medium Spender\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"123-456-7891\",\n  \"totalSpend\": 5000,\n  \"visitsCount\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "customers"]
            }
          }
        },
        {
          "name": "Create Customer 3 - Low Spender",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Low Spender\",\n  \"email\": \"bob@example.com\",\n  \"phone\": \"123-456-7892\",\n  \"totalSpend\": 500,\n  \"visitsCount\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "customers"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Vendor API Testing",
      "item": [
        {
          "name": "Vendor Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/vendor/health",
              "host": ["{{base_url}}"],
              "path": ["vendor", "health"]
            }
          }
        },
        {
          "name": "Test Vendor Send - Single Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_id\": \"test-msg-123\",\n  \"customer_id\": \"customer-123\",\n  \"campaign_id\": \"campaign-123\",\n  \"message\": \"Test message for vendor API\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/vendor/send",
              "host": ["{{base_url}}"],
              "path": ["vendor", "send"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Campaign Creation & Sending",
      "item": [
        {
          "name": "Create Campaign - High Spenders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Step 7 Vendor Test Campaign\",\n  \"rules_json\": \"{\\\"op\\\":\\\"AND\\\",\\\"rules\\\":[{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":1000}]}\",\n  \"messageTemplate\": \"Hello! This is a Step 7 vendor test message. You should see 90% success rate!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaigns",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns"]
            }
          }
        },
        {
          "name": "Send Campaign - Triggers Vendor API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaigns/{{campaign_id}}/send",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns", "{{campaign_id}}", "send"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Monitor Results",
      "item": [
        {
          "name": "Check Campaign Stats - Initial",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/campaigns/{{campaign_id}}/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns", "{{campaign_id}}", "stats"]
            }
          }
        },
        {
          "name": "Wait 5 seconds for vendor processing",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Check Campaign Stats - After Vendor Processing",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/campaigns/{{campaign_id}}/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns", "{{campaign_id}}", "stats"]
            }
          }
        },
        {
          "name": "Get All Campaigns - Check Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/campaigns",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Test Multiple Campaigns (90/10 Ratio)",
      "item": [
        {
          "name": "Create Campaign 2 - All Customers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Step 7 Ratio Test Campaign\",\n  \"rules_json\": \"{\\\"op\\\":\\\"AND\\\",\\\"rules\\\":[{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":0}]}\",\n  \"messageTemplate\": \"This campaign targets ALL customers to test 90/10 ratio!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaigns",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns"]
            }
          }
        },
        {
          "name": "Send Campaign 2 - Test Ratio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaigns/{{campaign_id_2}}/send",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns", "{{campaign_id_2}}", "send"]
            }
          }
        },
        {
          "name": "Wait 10 seconds for all vendor processing",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Final Stats - Check 90/10 Ratio",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/campaigns/{{campaign_id_2}}/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns", "{{campaign_id_2}}", "stats"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "campaign_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "campaign_id_2",
      "value": "",
      "type": "string"
    }
  ]
}
