        {
          "name": "Create Campaign - High Spenders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"High Spenders Campaign\",\n  \"rules_json\": \"{\\\"op\\\":\\\"AND\\\",\\\"rules\\\":[{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":10000}]}\",\n  \"messageTemplate\": \"Hello VIP customer! You've spent over $10,000 with us. Here's a special offer just for you!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaigns",
              "host": ["{{base_url}}"],
              "path": ["api", "campaigns"]
            }
          }
        },
        {
          "name": "Create Campaign - Complex Rules",
          "request": {
            "method": "POST",
