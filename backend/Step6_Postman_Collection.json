              "raw": "{\n  \"name\": \"Loyal Customers Campaign\",\n  \"rules_json\": \"{\\\"op\\\":\\\"OR\\\",\\\"rules\\\":[{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":5000},{\\\"op\\\":\\\"AND\\\",\\\"rules\\\":[{\\\"field\\\":\\\"visits_count\\\",\\\"operator\\\":\\\">=\\\",\\\"value\\\":3},{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":1000}]}]}\",\n  \"messageTemplate\": \"Thank you for being a loyal customer! Check out our latest products.\"\n}"
