    {
      "name": "2. Rules Engine Testing",
      "item": [
        {
          "name": "Preview Audience - High Spenders (>10000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rules_json\": \"{\\\"op\\\":\\\"AND\\\",\\\"rules\\\":[{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":10000}]}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/segments/preview",
              "host": ["{{base_url}}"],
              "path": ["api", "segments", "preview"]
            }
          }
        },
        {
          "name": "Preview Audience - Complex Rules (AND + OR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rules_json\": \"{\\\"op\\\":\\\"OR\\\",\\\"rules\\\":[{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":10000},{\\\"op\\\":\\\"AND\\\",\\\"rules\\\":[{\\\"field\\\":\\\"visits_count\\\",\\\"operator\\\":\\\">=\\\",\\\"value\\\":3},{\\\"field\\\":\\\"total_spend\\\",\\\"operator\\\":\\\">\\\",\\\"value\\\":1000}]}]}\"\n}"
