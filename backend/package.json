{
  "name": "mini-crm-backend",
  "version": "1.0.0",
  "description": "Mini CRM Platform Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:redis": "nodemon src/index-with-redis.ts",
    "dev:simple": "node simple-test-server.js",
    "build": "npx tsc",
    "start": "node render-start.js",
    "start:railway": "node railway-production-start.js",
    "start:render": "node render-start.js",
    "railway:setup": "node railway-setup.js",
    "start:dev": "node simple-test-server.js",
    "worker": "ts-node src/workers/customerWorker.ts",
    "worker:dev": "nodemon --exec ts-node src/workers/customerWorker.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:init": "node init-database.js",
    "db:test": "node test-db-connection.js",
    "redis:test": "node test-redis-connection.js",
    "db:fix": "node fix-missing-columns.js",
    "db:sql-fix": "node run-sql-fix.js",
    "db:auto-fix": "node auto-fix-startup.js",
    "db:fix-messageid": "node add-messageid-column.js",
    "db:fix-communicationlog": "node fix-communicationlog-schema.js",
    "fix-messageid": "node one-time-messageid-fix.js",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma"
  },
  "keywords": [
    "crm",
    "api",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1"
  }
}
