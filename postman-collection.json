        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"priya.sharma@example.com\",\n  \"phone\": \"+919876543210\",\n  \"total_spend\": 2500.75,\n  \"last_active\": \"2024-01-15T10:30:00Z\",\n  \"visits_count\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            }
          },
          "response": []
        },
        {
          "name": "Create Customer (Minimal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
